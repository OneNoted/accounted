NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_APP_URL=https://your-domain.com
CRON_SECRET=generate-a-random-secret

# Self-hosted (Docker) flag: disables hosted-only services, not MFA.
NEXT_PUBLIC_SELF_HOSTED=true

# Set both explicitly and identically. The server value is runtime policy; the
# public value controls client UI. Docker rejects missing, malformed, or
# mismatched values. Use true for mandatory TOTP, false for optional TOTP.
REQUIRE_MFA=false
NEXT_PUBLIC_REQUIRE_MFA=false

# Optional: WebSocket origin allowed for Supabase Realtime in the CSP.
# Defaults to NEXT_PUBLIC_SUPABASE_URL with https:// replaced by wss://
# (http:// by ws://). Set only if Realtime is served from another origin.
# NEXT_PUBLIC_SUPABASE_WS_URL=wss://your-project.supabase.co
